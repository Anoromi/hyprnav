{
  "manifest_version": 3,
  "name": "Hyprnav browser navigation",
  "version": "0.2.0",
  "description": "Navigate named tabs using one workspace query parameter.",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "minimum_chrome_version": "112",
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
