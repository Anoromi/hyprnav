# hyprnav-capture: Wayland client that pairs window addresses with
# ext-foreign-toplevel identifiers and streams JPEG frames of single windows.
#
# The protocol glue is generated by wayland-scanner at build time; nothing
# generated is checked in.

PREFIX ?= /usr/local
BINDIR ?= $(PREFIX)/bin
PKG_CONFIG ?= pkg-config
WAYLAND_SCANNER ?= $(shell $(PKG_CONFIG) --variable=wayland_scanner wayland-scanner 2>/dev/null || echo wayland-scanner)
WAYLAND_PROTOCOLS_DIR ?= $(shell $(PKG_CONFIG) --variable=pkgdatadir wayland-protocols)
HYPRLAND_PROTOCOLS_DIR ?= $(shell $(PKG_CONFIG) --variable=pkgdatadir hyprland-protocols)
WLR_PROTOCOLS_DIR ?= $(shell $(PKG_CONFIG) --variable=pkgdatadir wlr-protocols)

STAGING = $(WAYLAND_PROTOCOLS_DIR)/staging
FTL_XML = $(STAGING)/ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1.xml
SRC_XML = $(STAGING)/ext-image-capture-source/ext-image-capture-source-v1.xml
CAP_XML = $(STAGING)/ext-image-copy-capture/ext-image-copy-capture-v1.xml
MAP_XML = $(HYPRLAND_PROTOCOLS_DIR)/protocols/hyprland-toplevel-mapping-v1.xml
EXPORT_XML = $(HYPRLAND_PROTOCOLS_DIR)/protocols/hyprland-toplevel-export-v1.xml
# hyprland-toplevel-mapping-v1 also accepts zwlr toplevel handles, so its
# interface table references wlr-foreign-toplevel-management even though only
# the ext- path is used here; the generated code still has to be linked in.
WLR_XML = $(WLR_PROTOCOLS_DIR)/unstable/wlr-foreign-toplevel-management-unstable-v1.xml

PROTOCOLS = \
	ext-foreign-toplevel-list-v1 \
	ext-image-capture-source-v1 \
	ext-image-copy-capture-v1 \
	hyprland-toplevel-mapping-v1 \
	hyprland-toplevel-export-v1 \
	wlr-foreign-toplevel-management-unstable-v1

HEADERS = $(PROTOCOLS:%=%-client-protocol.h)
SOURCES = $(PROTOCOLS:%=%-protocol.c)
OBJECTS = main.o $(PROTOCOLS:%=%-protocol.o)

CFLAGS ?= -O2 -Wall -Wextra
CFLAGS += -I. $(shell $(PKG_CONFIG) --cflags wayland-client libturbojpeg)
LDLIBS += $(shell $(PKG_CONFIG) --libs wayland-client libturbojpeg)

all: hyprnav-capture

ext-foreign-toplevel-list-v1-client-protocol.h: $(FTL_XML)
	$(WAYLAND_SCANNER) client-header $< $@
ext-foreign-toplevel-list-v1-protocol.c: $(FTL_XML)
	$(WAYLAND_SCANNER) private-code $< $@
ext-image-capture-source-v1-client-protocol.h: $(SRC_XML)
	$(WAYLAND_SCANNER) client-header $< $@
ext-image-capture-source-v1-protocol.c: $(SRC_XML)
	$(WAYLAND_SCANNER) private-code $< $@
ext-image-copy-capture-v1-client-protocol.h: $(CAP_XML)
	$(WAYLAND_SCANNER) client-header $< $@
ext-image-copy-capture-v1-protocol.c: $(CAP_XML)
	$(WAYLAND_SCANNER) private-code $< $@
hyprland-toplevel-mapping-v1-client-protocol.h: $(MAP_XML)
	$(WAYLAND_SCANNER) client-header $< $@
hyprland-toplevel-mapping-v1-protocol.c: $(MAP_XML)
	$(WAYLAND_SCANNER) private-code $< $@
hyprland-toplevel-export-v1-client-protocol.h: $(EXPORT_XML)
	$(WAYLAND_SCANNER) client-header $< $@
hyprland-toplevel-export-v1-protocol.c: $(EXPORT_XML)
	$(WAYLAND_SCANNER) private-code $< $@
wlr-foreign-toplevel-management-unstable-v1-client-protocol.h: $(WLR_XML)
	$(WAYLAND_SCANNER) client-header $< $@
wlr-foreign-toplevel-management-unstable-v1-protocol.c: $(WLR_XML)
	$(WAYLAND_SCANNER) private-code $< $@

main.o: main.c $(HEADERS)

hyprnav-capture: $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS) $(LDLIBS)

install: hyprnav-capture
	install -Dm755 hyprnav-capture $(DESTDIR)$(BINDIR)/hyprnav-capture
	ln -sf hyprnav-capture $(DESTDIR)$(BINDIR)/hyprnav-toplevel-map

clean:
	rm -f hyprnav-capture *.o $(HEADERS) $(SOURCES)

.PHONY: all install clean
